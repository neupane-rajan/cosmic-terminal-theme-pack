{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "auto",
    "width": 20,
    "height": 10
  },
  "display": {
    "separator": " ➜  ",
    "color": {
      "separator": "blue"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS   "
    },
    {
      "type": "host",
      "key": "Host "
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "packages",
      "key": "Pkgs "
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "display",
      "key": "Disk "
    },
    {
      "type": "wm",
      "key": "WM   "
    },
    {
      "type": "terminal",
      "key": "Term "
    },
    {
      "type": "cpu",
      "key": "CPU  "
    },
    {
      "type": "gpu",
      "key": "GPU  "
    },
    {
      "type": "memory",
      "key": "RAM  "
    },
    "break",
    {
        "type": "custom",
        "format": "Shortcuts: cosmic-fetch (Show) | cosmic-theme (Switch)"
    },
    "colors"
  ]
}
